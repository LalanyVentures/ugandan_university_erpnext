{
  "name": "ugandan-university-frontend",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base=/assets/ugandan_university_education/frontend/ && npm run copy-html-entry",
    "build:jdd": "tsc --noEmit && vite build --config vite.config.jdd.js",
    "preview": "vite preview",
    "copy-html-entry": "node -e \"require('fs').copyFileSync('../ugandan_university_education/public/frontend/index.html','../ugandan_university_education/www/student-portal.html')\""
  },
  "dependencies": {
    "@fontsource/manrope": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
