{
  "doctype": "DocType",
  "name": "Student",
  "module": "University",
  "autoname": "field:student_number",
  "title_field": "student_name",
  "fields": [
    {"fieldname": "student_number", "label": "Student Number", "fieldtype": "Data", "reqd": 1, "unique": 1},
    {"fieldname": "student_name", "label": "Student Name", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "first_name", "label": "First Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "middle_name", "label": "Middle Name", "fieldtype": "Data"},
    {"fieldname": "last_name", "label": "Last Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "gender", "label": "Gender", "fieldtype": "Select", "options": "Male\nFemale\nOther"},
    {"fieldname": "date_of_birth", "label": "Date of Birth", "fieldtype": "Date"},
    {"fieldname": "nationality", "label": "Nationality", "fieldtype": "Data", "default": "Ugandan"},
    {"fieldname": "student_email_id", "label": "Student Email", "fieldtype": "Data"},
    {"fieldname": "user", "label": "Portal User", "fieldtype": "Link", "options": "User"},
    {"fieldname": "customer", "label": "ERPNext Customer", "fieldtype": "Link", "options": "Customer"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Applicant\nActive\nOn Leave\nCompleted\nDiscontinued\nWithdrawn", "default": "Applicant", "reqd": 1}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Academics User", "read": 1, "write": 1, "create": 1}, {"role": "Student", "read": 1}],
  "track_changes": 1
}
