{
  "doctype": "DocType",
  "name": "Academic Transcript",
  "module": "University",
  "autoname": "format:TRN-{YYYY}-{#####}",
  "is_submittable": 1,
  "fields": [
    {"fieldname": "student", "label": "Student", "fieldtype": "Link", "options": "Student", "reqd": 1},
    {"fieldname": "academic_programme", "label": "Academic Programme", "fieldtype": "Link", "options": "Academic Programme", "reqd": 1},
    {"fieldname": "transcript_type", "label": "Transcript Type", "fieldtype": "Select", "options": "Provisional\nOfficial\nReplacement\nVerification Copy", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nFaculty Head Review\nFaculty Head Approved\nRegistrar Issued\nRevoked", "default": "Draft", "reqd": 1},
    {"fieldname": "source_result_version", "label": "Source Result Version", "fieldtype": "Data"},
    {"fieldname": "source_result_checksum", "label": "Source Result Checksum", "fieldtype": "Data"},
    {"fieldname": "faculty_head_user", "label": "Faculty Head", "fieldtype": "Link", "options": "User"},
    {"fieldname": "faculty_head_approved_on", "label": "Faculty Head Approved On", "fieldtype": "Datetime"},
    {"fieldname": "registrar_user", "label": "Registrar", "fieldtype": "Link", "options": "User"},
    {"fieldname": "registrar_issued_on", "label": "Registrar Issued On", "fieldtype": "Datetime"},
    {"fieldname": "verification_number", "label": "Verification Number", "fieldtype": "Data"},
    {"fieldname": "generated_pdf", "label": "Generated PDF", "fieldtype": "Attach"},
    {"fieldname": "revocation_reason", "label": "Revocation Reason", "fieldtype": "Small Text"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Academics User", "read": 1, "write": 1, "create": 1}, {"role": "Student", "read": 1}],
  "track_changes": 1
}
