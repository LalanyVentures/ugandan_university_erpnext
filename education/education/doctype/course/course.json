  "autoname": "field:course_code",
  "fields": [
    {"fieldname": "course_code", "label": "Course Code", "fieldtype": "Data", "reqd": 1, "unique": 1},
    {"fieldname": "course_name", "label": "Course Unit Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "academic_unit", "label": "Academic Unit", "fieldtype": "Link", "options": "Academic Unit"},
    {"fieldname": "credit_units", "label": "Credit Units", "fieldtype": "Float", "reqd": 1},
    {"fieldname": "study_level", "label": "Study Level", "fieldtype": "Int"},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nActive\nRetired", "default": "Draft", "reqd": 1}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Academics User", "read": 1, "write": 1, "create": 1}, {"role": "Student", "read": 1}],
  "track_changes": 1
