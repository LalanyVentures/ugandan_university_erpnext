{
  "doctype": "DocType",
  "name": "Result Review Request",
  "module": "Education",
  "autoname": "format:RRR-{YYYY}-{#####}",
  "fields": [
    {"fieldname": "student", "label": "Student", "fieldtype": "Link", "options": "Student", "reqd": 1},
    {"fieldname": "student_course_result", "label": "Student Course Result", "fieldtype": "Link", "options": "Student Course Result", "reqd": 1},
    {"fieldname": "request_type", "label": "Request Type", "fieldtype": "Select", "options": "Mark Review\nGrade Appeal\nIncomplete Resolution\nRetake Request", "reqd": 1},
    {"fieldname": "reason", "label": "Reason", "fieldtype": "Small Text", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Submitted\nUnder Review\nApproved\nRejected\nResolved", "default": "Submitted", "reqd": 1},
    {"fieldname": "decision", "label": "Decision", "fieldtype": "Small Text"},
    {"fieldname": "reviewed_by", "label": "Reviewed By", "fieldtype": "Link", "options": "User"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Academics User", "read": 1, "write": 1, "create": 1}, {"role": "Student", "read": 1, "create": 1}],
  "track_changes": 1
}
