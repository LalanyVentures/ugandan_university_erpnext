{
  "doctype": "DocType",
  "name": "University Application",
  "module": "Education",
  "autoname": "format:APP-{YYYY}-{#####}",
  "fields": [
    {"fieldname": "application_number", "label": "Application Number", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "applicant_name", "label": "Applicant Name", "fieldtype": "Data", "reqd": 1},
    {"fieldname": "applicant_email", "label": "Applicant Email", "fieldtype": "Data"},
    {"fieldname": "academic_programme", "label": "Academic Programme", "fieldtype": "Link", "options": "Academic Programme", "reqd": 1},
    {"fieldname": "programme_curriculum", "label": "Programme Curriculum", "fieldtype": "Link", "options": "Programme Curriculum"},
    {"fieldname": "academic_year", "label": "Academic Year", "fieldtype": "Link", "options": "Academic Year", "reqd": 1},
    {"fieldname": "application_date", "label": "Application Date", "fieldtype": "Date", "reqd": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Draft\nSubmitted\nUnder Review\nAccepted\nRejected\nWithdrawn", "default": "Draft", "reqd": 1},
    {"fieldname": "student", "label": "Student", "fieldtype": "Link", "options": "Student"},
    {"fieldname": "reviewed_by", "label": "Reviewed By", "fieldtype": "Link", "options": "User"},
    {"fieldname": "review_comments", "label": "Review Comments", "fieldtype": "Small Text"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Academics User", "read": 1, "write": 1, "create": 1}, {"role": "Student", "read": 1, "create": 1}],
  "track_changes": 1
}
